        "summary": "Permanently delete the account, all its devices and everything synced. Needs the password again.\nA POST (not DELETE) because some mobile HTTP clients can't send a body with DELETE.\nThrottled like the auth routes: this endpoint verifies a password.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/sync/push": {
      "post": {
        "operationId": "SyncController_push",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushDto"
              }
            }
          }
        },
        "responses": {
          "200": {
