# Postgres connection string. Local dev: `createdb nowfocus` then run `pnpm run migrate`.
DATABASE_URL=postgres://localhost:5432/nowfocus
# >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
PORT=3000
# Interface to bind. Loopback by default: only the reverse proxy should reach the app.
# Point the proxy at 127.0.0.1:PORT (not `localhost`, which can resolve to ::1).
HOST=127.0.0.1
# Proxy hops to trust for the client IP behind the per-IP throttle. 1 = nginx in front, which must overwrite
# X-Forwarded-For (see deploy notes in README). 0 = no proxy (local dev, direct clients).
TRUST_PROXY=1
# Extra allowed browser origins (comma-separated). Local web dev: http://localhost:8080
CORS_ORIGINS=

# GitHub token to post waitlist feature requests as issues on the repo
GITHUB_TOKEN=
# The GitHub repository to post issues to (default: safwat-fathi/NowFocus)
GITHUB_REPO=safwat-fathi/NowFocus
