{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NowFocus",
  "version": "0.4.3",
  "identifier": "app.getnowfocus.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NowFocus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDMkRCMTE1NjY5M0FGNDEKUldSQnI1Tm1GYkV0TEYzNHdJY2JJQm1RQlRIQlVlK3lTZWNzeXpNdDNlTlFoK3BiRTJid3h2cFUK",
      "endpoints": ["https://api.nowfocus.online/v1/updates/windows/{{current_version}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
