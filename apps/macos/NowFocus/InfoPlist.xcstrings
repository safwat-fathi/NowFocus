{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ NowFocus تسجيل ملاحظة مدتها 10 ثوانٍ لنفسك للجلسة الصارمة. تبقى على هذا الـ Mac، وتسمعها فقط إن حاولت إنهاء تلك الجلسة مبكرًا."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الجلسة يسأل NowFocus متصفحك عن عنوان التبويب الأمامي ليغلق صفحات Shorts وReels التي اخترت حجبها. يُفحص العنوان ثم يُنسى؛ لا يُحفظ ولا يُرسل أبدًا."
          }
        }
      }
    }
  },
  "version": "1.0"
}
