    "A few quick questions, all optional, and you're done. Everything stays on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بضعة أسئلة سريعة، كلها اختيارية، وننتهي. كل شيء يبقى على هذا الـ Mac."
          }
        }
      }
    },
