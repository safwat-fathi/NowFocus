    "%lld changes couldn’t be synced. They stay on this Mac; edit them to try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تعذّرت مزامنة %lld تغيير. تبقى على هذا الـ Mac؛ عدّلها لتحاول مجددًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تعذّرت مزامنة تغيير واحد. يبقى على هذا الـ Mac؛ عدّله لتحاول مجددًا."
